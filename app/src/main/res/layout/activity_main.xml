<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".MainActivity">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şifreli Kasa"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/txtDuyuru"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Duyuru " />
        </LinearLayout>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/rounded_corner"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/user" />
        </FrameLayout>
    </LinearLayout>

    <!-- Main Content Area -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner / ViewPager Slider Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/round_corner_buttom"
                android:padding="2dp"
                android:layout_marginBottom="24dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- Daily Question Quick Action Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_gunluksoru"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/round_corner_buttom"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/saat"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView8">

                    <TextView
                        android:id="@+id/textView16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Günlük Soru"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Her gün yeni ödüller"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtkalansure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24h 00m 00s"
                    android:textColor="@color/cyan_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Dual Cards Row -->
            <LinearLayout
                android:id="@+id/layout_yan"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Left Arena / Sword Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/round_corner_buttom"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/imageView14"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:src="@drawable/sword"
                        android:scaleType="fitCenter"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/tvLeftCardLabel" />

                    <TextView
                        android:id="@+id/tvLeftCardLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mücadele Arenası"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/imageView10"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Right Wheel / Fortune Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_SansCark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/round_corner_buttom"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/btn_cark"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:src="@drawable/wheeloffortune"
                        android:scaleType="fitCenter"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/tvRightCardLabel" />

                    <TextView
                        android:id="@+id/tvRightCardLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Şans Çarkı"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/imageView12"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <!-- Bottom Adventure Wide Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_yolculukdag"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/round_corner_buttom"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/imageView15"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/yolculukdag"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#60000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kar Yolculuğu"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_margin="16dp" />

                <ImageView
                    android:id="@+id/imageView9"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Overlay 1: Daily Quiz Pop-up Dialog (F1F1F1 replaced with premium glassmorphic dark container) -->
    <LinearLayout
        android:id="@+id/layout_gunluksoru"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#E5040209"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationContainer"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner_buttom"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GÜNLÜK SORU"
                    android:textColor="@color/cyan_accent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/timer_indicator_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gold_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp"
                        tools:text="5:46" />

                    <ImageView
                        android:id="@+id/space1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/exit"
                        app:tint="@color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Decorative header image -->
            <ImageView
                android:id="@+id/imageView18"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:layout_marginBottom="16dp"
                app:srcCompat="@drawable/gunluksoruyazisi" />

            <!-- Question Box -->
            <TextView
                android:id="@+id/txtGunlukSoru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="24dp"
                tools:text="Hangi şifreli kasa en güvenlidir?" />

            <!-- 4 Options Buttons -->
            <Button
                android:id="@+id/btnGunlukCevap1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/rounded_corner"
                android:text="A Seçeneği"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGunlukCevap2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/rounded_corner"
                android:text="B Seçeneği"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGunlukCevap3"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/rounded_corner"
                android:text="C Seçeneği"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGunlukCevap4"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/rounded_corner"
                android:text="D Seçeneği"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay 2: Daily Wheel Fortune Dialog (F1F1F1 replaced with premium glassmorphic dark container) -->
    <LinearLayout
        android:id="@+id/layoutGunlukCark"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#E5040209"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationContainer"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_corner_buttom"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <!-- Wheel Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:layout_toStartOf="@+id/space2"
                    app:srcCompat="@drawable/gunlukcarkifelakyazisi" />

                <ImageView
                    android:id="@+id/space2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/exit"
                    app:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Wheel Pointer -->
            <ImageView
                android:id="@+id/imageView13"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/pointer"
                android:scaleType="fitCenter"
                android:layout_marginBottom="4dp" />

            <!-- The Wheel Dial -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/imageView11"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/quizgamecar" />
            </FrameLayout>

            <!-- HEYCANLANDIM Status Display -->
            <TextView
                android:id="@+id/txtAltin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="HEYCANLANDIM!"
                android:textColor="@color/gold_accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Color Reward Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="#15FFFFFF"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="6dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@color/error_red"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5-15 Altın"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="6dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="#FFFF00FF"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25-50 Altın"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="6dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@color/blue"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boş / 100 Altın"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spin / Remaining Duration Button -->
            <Button
                android:id="@+id/btnspin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_cyan_accent"
                android:backgroundTint="@color/purple_accent"
                android:text="Şansını Dene"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar wrapper -->
    <RelativeLayout
        android:id="@+id/bottomNavigationContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/round_corner_buttom"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Home Tab (Active) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnAnasayfa"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/home"
                    app:tint="@color/cyan_accent" />

                <TextView
                    android:id="@+id/txtAnaSayfa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ana Sayfa"
                    android:textColor="@color/cyan_accent"
                    android:textStyle="bold"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Category Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnKategori"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/kategori"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/txtKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kategori"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bonus Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnGunluk"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/heart"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/txtGunluk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Günlük Bonus"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Profile Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnProfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/user"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/txtProfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Profil"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <!-- Retaining deprecated components in tiny invisible bounds to satisfy any direct layout references -->
    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/lyt_mainbos"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/btnAnasayfa1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/btnKategori1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/btnGunluk1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/btnProfil1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />



</androidx.constraintlayout.widget.ConstraintLayout>