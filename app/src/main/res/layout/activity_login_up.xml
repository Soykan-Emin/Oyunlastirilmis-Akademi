<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".ui.login.LoginUpActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Title & Subtitle Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hesap Oluştur"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kasaya güvenle girmek için üye olun"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Glassmorphic Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/round_corner_buttom"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Üye Ol"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- Email Input -->
                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="E-posta Adresi"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Password Input -->
                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="Şifre"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginBottom="24dp" />

                <!-- Action Button -->
                <Button
                    android:id="@+id/btnUyeol"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_cyan_accent"
                    app:backgroundTint="@color/cyan_accent"
                    android:text="Üye Ol"
                    android:textColor="@color/deep_purple"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp" />

                <!-- Loading Spinner -->
                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/cyan_accent"
                    android:visibility="gone" />

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/btnSifre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="Şifreni mi Unuttun?"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Back to Login Prompt -->
            <TextView
                android:id="@+id/btngeridon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Zaten bir hesabın var mı? Giriş Yap"
                android:textColor="@color/cyan_accent"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
