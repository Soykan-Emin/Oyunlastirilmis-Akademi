<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".PasswordForgetActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Title Header -->
            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şifremi Unuttum"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Güvenli şifre sıfırlama paneli"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Glass Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/round_corner_buttom"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Email Input -->
                <EditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="Kayıtlı E-posta Adresi"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Question / Answer Recovery Section (retaining original elements) -->
                <TextView
                    android:id="@+id/questionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"
                    tools:text="Güvenlik Sorusu:" />

                <EditText
                    android:id="@+id/answerEditText"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="Cevabınız"
                    android:paddingStart="16dp"
                    android:paddingLeft="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Robot Check Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <CheckBox
                        android:id="@+id/check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ben robot değilim"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:buttonTint="@color/cyan_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/imageView1"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        app:srcCompat="@drawable/recaptcha"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <!-- Action Button 1: Send Mail -->
                <Button
                    android:id="@+id/btnMailGonder"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_cyan_accent"
                    app:backgroundTint="@color/cyan_accent"
                    android:text="E-posta Gönder"
                    android:textColor="@color/deep_purple"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- Action Button 2: Verify -->
                <Button
                    android:id="@+id/btnDogrula"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_cyan_accent"
                    app:backgroundTint="@color/gold_accent"
                    android:text="Doğrula"
                    android:textColor="@color/deep_purple"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <!-- Result Status TextView -->
                <TextView
                    android:id="@+id/resultTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/cyan_accent"
                    android:textSize="16sp"
                    android:gravity="center"
                    tools:text="Başarılı" />
            </LinearLayout>

            <!-- Navigation Links -->
            <TextView
                android:id="@+id/btngeridon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Giriş Ekranına Dön"
                android:textColor="@color/cyan_accent"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnUyeol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Henüz hesabınız yok mu? Kaydol"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

    <!-- Invisible placeholder elements to satisfy any direct layout references -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>