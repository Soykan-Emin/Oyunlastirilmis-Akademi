<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".profilMenuActivity">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profil &amp; Menü"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/signIn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/logoutsiyah"
            app:tint="@color/error_red" />
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationContainer">

        <LinearLayout
            android:id="@+id/lytbos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Overview Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/round_corner_buttom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/rounded_corner">
                    
                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:padding="8dp"
                        android:src="@drawable/showman" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/userDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UserName"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        
                        <TextView
                            android:id="@+id/txtSurumYazısı"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sürüm:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtSurum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/cyan_accent"
                            android:textSize="12sp"
                            tools:text="1.0.0" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Actions Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="24dp">

                <!-- Invite Friends -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/round_corner_buttom"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btndavet"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/invt" />

                    <TextView
                        android:id="@+id/txtdavet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Davet Et"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Store -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/round_corner_buttom"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btnmagaza"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/badge" />

                    <TextView
                        android:id="@+id/txtmagaza"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mağaza"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Feedback -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/round_corner_buttom"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/btnfeedback"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/feedback" />

                    <TextView
                        android:id="@+id/txtgeribildirim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Geri Bildirim"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- FAQ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/round_corner_buttom"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/btnsss"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/support" />

                    <TextView
                        android:id="@+id/txtsss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="S.S.S."
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </GridLayout>

            <!-- Expanded Section: Feedback -->
            <LinearLayout
                android:id="@+id/lyt_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/round_corner_buttom"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textView19"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Geri Bildirim Gönder"
                    android:textColor="@color/cyan_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/feedbacklyt"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Uygulamamız ile ilgili sorunları ve önerilerinizi bize iletebilirsiniz."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/edtGeriBildirim"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="Mesajınızı buraya yazın..."
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/white"
                    android:gravity="top|start"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnGeriBildirim"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_cyan_accent"
                    android:text="Gönder"
                    android:textColor="@color/deep_purple"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Expanded Section: Invite -->
            <LinearLayout
                android:id="@+id/lyt_davet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/round_corner_buttom"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textView15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arkadaşını Davet Et"
                    android:textColor="@color/cyan_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <ImageView
                    android:id="@+id/imageView21"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/gift"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/textView18"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Arkadaşlarınızı davet etmek için bağlantıyı paylaşın. Hem siz hem de arkadaşınız kazansın!"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/edtcopylink"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_corner"
                        android:text="https://play.google.com/store/apps..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:padding="12dp"
                        android:editable="false"
                        android:focusable="false"
                        android:singleLine="true"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/btn_share"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/btn_cyan_accent"
                        android:padding="12dp"
                        android:src="@drawable/share" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expanded Section: Store -->
            <LinearLayout
                android:id="@+id/lyt_magaza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/round_corner_buttom"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kasa Mağazası"
                    android:textColor="@color/cyan_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Balances Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <!-- Diamond Balance -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/rounded_corner"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:id="@+id/imageView19"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/diamond" />

                        <TextView
                            android:id="@+id/txtelmas1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="5000"
                            android:textColor="@color/gold_accent"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Coin Balance -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/rounded_corner"
                        android:padding="12dp"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:id="@+id/imageView20"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/coin" />

                        <TextView
                            android:id="@+id/txtaltin1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="5000"
                            android:textColor="@color/gold_accent"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Store Products Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Product 1 -->
                    <LinearLayout
                        android:id="@+id/btnsepet1"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/rounded_corner"
                        android:padding="12dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/imageView25"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/marketbir"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imageView26"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/diamond" />

                            <TextView
                                android:id="@+id/textView22"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="100"
                                android:textColor="@color/gold_accent"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Product 2 -->
                    <LinearLayout
                        android:id="@+id/btnsepet2"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/rounded_corner"
                        android:padding="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imageView31"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/yarimsaatiki"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/imageView32"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/diamond" />

                            <TextView
                                android:id="@+id/textView29"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="50"
                                android:textColor="@color/gold_accent"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Unified Glassmorphic Bottom Navigation Bar -->
    <RelativeLayout
        android:id="@+id/bottomNavigationContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/round_corner_buttom"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Home Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnAnasayfa"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/home"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/txtAnaSayfa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ana Sayfa"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Category Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnKategori"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/kategori"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/txtKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kategori"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bonus Tab -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnGunluk"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/heart"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/txtGunluk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Günlük Bonus"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Profile Tab (Active) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnProfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/user"
                    app:tint="@color/cyan_accent" />

                <TextView
                    android:id="@+id/txtProfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Profil"
                    android:textColor="@color/cyan_accent"
                    android:textStyle="bold"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <!-- Invisible backwards-compatibility placeholders -->
    <TextView android:id="@+id/textView25" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView26" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView24" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView27" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView114" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/btnAnasayfa1" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView191" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/btnKategori1" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView111" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/btnGunluk1" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView112" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/btnProfil1" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView113" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView14" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView9" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView11" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView12" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/textView13" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>